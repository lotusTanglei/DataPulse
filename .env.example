# Generate with the command documented in README.md before use.
DATAPULSE_MASTER_KEY=generate-before-use
# A separate URL-safe Base64 value that decodes to exactly 32 bytes.
DATAPULSE_SIGNING_KEY=generate-before-use
DATAPULSE_DATA_DIR=/data
# Host port for the HTTP service; the container port remains 8000.
DATAPULSE_HTTP_PORT=8000
# Keep the loopback default unless DataPulse is behind a trusted proxy. Never use *.
DATAPULSE_FORWARDED_ALLOW_IPS=127.0.0.1
DATAPULSE_FILE_MAX_BYTES=104857600
DATAPULSE_FILE_MAX_ROWS=5000
# Screen image/GeoJSON/subtitle payloads and audio/video payloads have separate limits.
DATAPULSE_ASSET_MAX_BYTES=5242880
DATAPULSE_ASSET_MEDIA_MAX_BYTES=104857600
DATAPULSE_ASSET_TOTAL_BYTES=1073741824
DATAPULSE_ASSET_TOTAL_DURATION_SECONDS=36000
DATAPULSE_ASSET_MAX_COUNT=10000
# Comma-separated MIME allowlist, or * for all built-in safe formats.
DATAPULSE_ASSET_ALLOWED_MIME_TYPES=*
DATAPULSE_MEDIA_MAX_PIXELS=33554432
DATAPULSE_MEDIA_MAX_DURATION_SECONDS=300
DATAPULSE_MEDIA_TIMEOUT_SECONDS=30
DATAPULSE_MEDIA_CONCURRENCY=2
# Optional antivirus argv, appended with a generated file path; never evaluated by a shell.
# Install ClamAV and provision its signature database before enabling this example:
# DATAPULSE_UPLOAD_SCANNER_COMMAND=["/usr/bin/clamscan","--no-summary","--infected"]
DATAPULSE_UPLOAD_SCANNER_COMMAND=[]
DATAPULSE_UPLOAD_SCANNER_TIMEOUT_SECONDS=30
DATAPULSE_UPLOAD_SCANNER_MEMORY_MB=1024
DATAPULSE_UPLOAD_SCANNER_CONCURRENCY=2
DATAPULSE_DUCKDB_THREADS=2
DATAPULSE_DUCKDB_MEMORY_LIMIT=512MB
DATAPULSE_DUCKDB_TIMEOUT_SECONDS=30
DATAPULSE_AI_ENABLED=false
# OpenAI-compatible endpoint. Dataset schemas and bounded samples are sent here.
DATAPULSE_AI_BASE_URL=https://api.openai.com/v1
DATAPULSE_AI_API_KEY=generate-before-use
DATAPULSE_AI_MODEL=your-model
DATAPULSE_AI_TIMEOUT_SECONDS=30
# Valid range: 1-100. This limits rows included per dataset in AI context.
DATAPULSE_AI_MAX_CONTEXT_ROWS=100
# Run speech execution in a separate durable process when the API is scaled out.
DATAPULSE_SPEECH_WORKER_ENABLED=true
DATAPULSE_SPEECH_RECOVER_ON_STARTUP=true
# Optional: bearer token for an internal Prometheus scraper. Leave empty to disable.
DATAPULSE_METRICS_TOKEN=
