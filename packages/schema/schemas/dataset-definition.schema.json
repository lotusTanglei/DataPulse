{
  "$defs": {
    "CachePolicy": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "disabled",
          "enum": [
            "disabled",
            "ttl",
            "scheduled"
          ],
          "title": "Mode",
          "type": "string"
        },
        "ttl_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttl Seconds"
        }
      },
      "title": "CachePolicy",
      "type": "object"
    },
    "CalculatedFieldExpression": {
      "additionalProperties": false,
      "properties": {
        "constant": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constant"
        },
        "left_field": {
          "minLength": 1,
          "title": "Left Field",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/CalculationOperator"
        },
        "right_field": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right Field"
        }
      },
      "required": [
        "left_field",
        "operator"
      ],
      "title": "CalculatedFieldExpression",
      "type": "object"
    },
    "CalculationOperator": {
      "enum": [
        "add",
        "subtract",
        "multiply",
        "divide"
      ],
      "title": "CalculationOperator",
      "type": "string"
    },
    "DataType": {
      "enum": [
        "boolean",
        "date",
        "datetime",
        "integer",
        "number",
        "string"
      ],
      "title": "DataType",
      "type": "string"
    },
    "DatasetCalculatedField": {
      "additionalProperties": false,
      "properties": {
        "data_type": {
          "$ref": "#/$defs/DataType"
        },
        "expression": {
          "$ref": "#/$defs/CalculatedFieldExpression"
        },
        "format": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "label",
        "data_type",
        "expression"
      ],
      "title": "DatasetCalculatedField",
      "type": "object"
    },
    "DatasetField": {
      "additionalProperties": false,
      "properties": {
        "data_type": {
          "$ref": "#/$defs/DataType"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "data_type"
      ],
      "title": "DatasetField",
      "type": "object"
    },
    "DatasetFieldOverride": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "data_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "default_aggregation": {
          "anyOf": [
            {
              "enum": [
                "sum",
                "avg",
                "min",
                "max",
                "count"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Aggregation"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "format": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "identifier",
                "dimension",
                "measure",
                "geography",
                "temporal",
                "text",
                "boolean",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name"
      ],
      "title": "DatasetFieldOverride",
      "type": "object"
    },
    "DatasetHierarchy": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "dimension",
            "time"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/DatasetHierarchyLevel"
          },
          "minItems": 2,
          "title": "Levels",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "kind",
        "levels"
      ],
      "title": "DatasetHierarchy",
      "type": "object"
    },
    "DatasetHierarchyLevel": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "time_grain": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeGrain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "field",
        "label"
      ],
      "title": "DatasetHierarchyLevel",
      "type": "object"
    },
    "DatasetMetric": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "enum": [
            "sum",
            "avg",
            "min",
            "max",
            "count"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "format": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_field": {
          "minLength": 1,
          "title": "Source Field",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "label",
        "source_field",
        "aggregation"
      ],
      "title": "DatasetMetric",
      "type": "object"
    },
    "DatasetParameter": {
      "additionalProperties": false,
      "properties": {
        "data_type": {
          "$ref": "#/$defs/DataType"
        },
        "default": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "data_type"
      ],
      "title": "DatasetParameter",
      "type": "object"
    },
    "DatasetRelationship": {
      "additionalProperties": false,
      "properties": {
        "cardinality": {
          "enum": [
            "one_to_one",
            "one_to_many",
            "many_to_one"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "local_field": {
          "minLength": 1,
          "title": "Local Field",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "target_dataset_id": {
          "minLength": 1,
          "title": "Target Dataset Id",
          "type": "string"
        },
        "target_field": {
          "minLength": 1,
          "title": "Target Field",
          "type": "string"
        }
      },
      "required": [
        "name",
        "target_dataset_id",
        "local_field",
        "target_field",
        "cardinality"
      ],
      "title": "DatasetRelationship",
      "type": "object"
    },
    "DatasetSemantics": {
      "additionalProperties": false,
      "properties": {
        "calculated_fields": {
          "items": {
            "$ref": "#/$defs/DatasetCalculatedField"
          },
          "title": "Calculated Fields",
          "type": "array"
        },
        "hierarchies": {
          "items": {
            "$ref": "#/$defs/DatasetHierarchy"
          },
          "title": "Hierarchies",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/DatasetMetric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/DatasetRelationship"
          },
          "title": "Relationships",
          "type": "array"
        }
      },
      "title": "DatasetSemantics",
      "type": "object"
    },
    "FileFormat": {
      "enum": [
        "csv",
        "excel",
        "json",
        "parquet"
      ],
      "title": "FileFormat",
      "type": "string"
    },
    "FileQuery": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/FileFormat"
        },
        "kind": {
          "const": "file",
          "default": "file",
          "title": "Kind",
          "type": "string"
        },
        "sheet_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Name"
        }
      },
      "required": [
        "asset_id",
        "format"
      ],
      "title": "FileQuery",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "RefreshPolicy": {
      "additionalProperties": false,
      "properties": {
        "cron": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cron"
        },
        "interval_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Seconds"
        },
        "mode": {
          "default": "manual",
          "enum": [
            "manual",
            "interval",
            "cron"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "RefreshPolicy",
      "type": "object"
    },
    "RestQuery": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "rest",
          "default": "rest",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "default": "GET",
          "enum": [
            "GET",
            "POST"
          ],
          "title": "Method",
          "type": "string"
        },
        "query": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Query",
          "type": "object"
        },
        "response_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Path"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "RestQuery",
      "type": "object"
    },
    "SqlQuery": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "sql",
          "default": "sql",
          "title": "Kind",
          "type": "string"
        },
        "sql": {
          "minLength": 1,
          "title": "Sql",
          "type": "string"
        }
      },
      "required": [
        "sql"
      ],
      "title": "SqlQuery",
      "type": "object"
    },
    "TableQuery": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "table",
          "default": "table",
          "title": "Kind",
          "type": "string"
        },
        "schema_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Name"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "table"
      ],
      "title": "TableQuery",
      "type": "object"
    },
    "TimeGrain": {
      "enum": [
        "year",
        "quarter",
        "month",
        "week",
        "day",
        "hour"
      ],
      "title": "TimeGrain",
      "type": "string"
    }
  },
  "$id": "https://datapulse.dev/schemas/v1/dataset-definition.schema.json",
  "additionalProperties": false,
  "properties": {
    "cache": {
      "$ref": "#/$defs/CachePolicy"
    },
    "data_source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Source Id"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/DatasetField"
      },
      "title": "Fields",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "max_rows": {
      "default": 5000,
      "maximum": 5000,
      "minimum": 1,
      "title": "Max Rows",
      "type": "integer"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/DatasetParameter"
      },
      "title": "Parameters",
      "type": "array"
    },
    "profile_overrides": {
      "items": {
        "$ref": "#/$defs/DatasetFieldOverride"
      },
      "title": "Profile Overrides",
      "type": "array"
    },
    "query": {
      "discriminator": {
        "mapping": {
          "file": "#/$defs/FileQuery",
          "rest": "#/$defs/RestQuery",
          "sql": "#/$defs/SqlQuery",
          "table": "#/$defs/TableQuery"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TableQuery"
        },
        {
          "$ref": "#/$defs/SqlQuery"
        },
        {
          "$ref": "#/$defs/FileQuery"
        },
        {
          "$ref": "#/$defs/RestQuery"
        }
      ],
      "title": "Query"
    },
    "refresh": {
      "$ref": "#/$defs/RefreshPolicy"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "semantics": {
      "$ref": "#/$defs/DatasetSemantics"
    },
    "timeout_seconds": {
      "default": 30,
      "maximum": 300,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "query"
  ],
  "title": "DatasetDefinition",
  "type": "object"
}
