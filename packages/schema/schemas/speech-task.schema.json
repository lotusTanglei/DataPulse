{
  "$id": "https://datapulse.dev/schemas/v1/speech-task.schema.json",
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "priority": {
      "default": 0,
      "maximum": 100,
      "minimum": -100,
      "title": "Priority",
      "type": "integer"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "source": {
      "default": "runtime",
      "maxLength": 64,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "plan_id",
    "status",
    "provider_id",
    "asset_id",
    "created_at"
  ],
  "title": "SpeechTaskResponse",
  "type": "object"
}
