{
  "$defs": {
    "Aggregation": {
      "enum": [
        "sum",
        "avg",
        "min",
        "max",
        "count"
      ],
      "title": "Aggregation",
      "type": "string"
    },
    "ChartType": {
      "enum": [
        "area",
        "bar",
        "funnel",
        "gauge",
        "heatmap",
        "kpi",
        "line",
        "map",
        "pie",
        "progress",
        "radar",
        "scatter",
        "table"
      ],
      "title": "ChartType",
      "type": "string"
    },
    "Filter": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/FilterOperator"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "literal": "#/$defs/LiteralValue",
              "parameter": "#/$defs/ParameterRef"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ParameterRef"
            },
            {
              "$ref": "#/$defs/LiteralValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "operator"
      ],
      "title": "Filter",
      "type": "object"
    },
    "FilterOperator": {
      "enum": [
        "equals",
        "not_equals",
        "greater_than",
        "greater_than_or_equal",
        "less_than",
        "less_than_or_equal",
        "in",
        "not_in",
        "contains",
        "between",
        "is_null",
        "is_not_null"
      ],
      "title": "FilterOperator",
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "LiteralValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "literal",
          "default": "literal",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "title": "LiteralValue",
      "type": "object"
    },
    "Measure": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "$ref": "#/$defs/Aggregation"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field",
        "aggregation"
      ],
      "title": "Measure",
      "type": "object"
    },
    "ParameterRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "parameter",
          "default": "parameter",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ParameterRef",
      "type": "object"
    },
    "Sort": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/$defs/SortDirection",
          "default": "asc"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "Sort",
      "type": "object"
    },
    "SortDirection": {
      "enum": [
        "asc",
        "desc"
      ],
      "title": "SortDirection",
      "type": "string"
    },
    "VisualSpec": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ChartType"
        }
      },
      "required": [
        "type"
      ],
      "title": "VisualSpec",
      "type": "object"
    }
  },
  "$id": "https://datapulse.dev/schemas/v1/chart-spec.schema.json",
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "filters": {
      "items": {
        "$ref": "#/$defs/Filter"
      },
      "title": "Filters",
      "type": "array"
    },
    "limit": {
      "default": 1000,
      "maximum": 5000,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "measures": {
      "items": {
        "$ref": "#/$defs/Measure"
      },
      "title": "Measures",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sort": {
      "items": {
        "$ref": "#/$defs/Sort"
      },
      "title": "Sort",
      "type": "array"
    },
    "visual": {
      "$ref": "#/$defs/VisualSpec"
    }
  },
  "required": [
    "dataset_id",
    "visual"
  ],
  "title": "ChartSpec",
  "type": "object"
}
