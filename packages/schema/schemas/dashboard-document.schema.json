{
  "$defs": {
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "background": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Background",
          "type": "object"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "ComponentInstance": {
      "additionalProperties": false,
      "properties": {
        "data_binding": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Data Binding",
          "type": "object"
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "interactions": {
          "items": {
            "$ref": "#/$defs/ComponentInteraction"
          },
          "title": "Interactions",
          "type": "array"
        },
        "props": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Props",
          "type": "object"
        },
        "state": {
          "$ref": "#/$defs/ComponentState"
        },
        "style": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Style",
          "type": "object"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "frame"
      ],
      "title": "ComponentInstance",
      "type": "object"
    },
    "ComponentInteraction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "set_parameter",
          "title": "Action",
          "type": "string"
        },
        "event": {
          "const": "click",
          "title": "Event",
          "type": "string"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "parameter": {
          "minLength": 1,
          "title": "Parameter",
          "type": "string"
        }
      },
      "required": [
        "event",
        "action",
        "parameter",
        "field"
      ],
      "title": "ComponentInteraction",
      "type": "object"
    },
    "ComponentState": {
      "additionalProperties": false,
      "properties": {
        "hidden": {
          "default": false,
          "title": "Hidden",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        }
      },
      "title": "ComponentState",
      "type": "object"
    },
    "DashboardParameter": {
      "additionalProperties": false,
      "properties": {
        "allowed_values": {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Allowed Values",
          "type": "array"
        },
        "data_type": {
          "$ref": "#/$defs/DataType"
        },
        "default": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mutable": {
          "default": false,
          "title": "Mutable",
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "data_type"
      ],
      "title": "DashboardParameter",
      "type": "object"
    },
    "DataType": {
      "enum": [
        "boolean",
        "date",
        "datetime",
        "integer",
        "number",
        "string"
      ],
      "title": "DataType",
      "type": "string"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z_index": {
          "default": 0,
          "title": "Z Index",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Frame",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "ScreenRefreshPolicy": {
      "additionalProperties": false,
      "properties": {
        "interval_seconds": {
          "anyOf": [
            {
              "enum": [
                10,
                30,
                60,
                300
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Seconds"
        },
        "mode": {
          "default": "disabled",
          "enum": [
            "disabled",
            "interval"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "ScreenRefreshPolicy",
      "type": "object"
    },
    "Theme": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "default": "datapulse-dark",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "tokens": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Tokens",
          "type": "object"
        }
      },
      "title": "Theme",
      "type": "object"
    }
  },
  "$id": "https://datapulse.dev/schemas/v1/dashboard-document.schema.json",
  "additionalProperties": false,
  "properties": {
    "canvas": {
      "$ref": "#/$defs/Canvas"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/ComponentInstance"
      },
      "title": "Components",
      "type": "array"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/DashboardParameter"
      },
      "title": "Parameters",
      "type": "array"
    },
    "refresh": {
      "$ref": "#/$defs/ScreenRefreshPolicy"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "theme": {
      "$ref": "#/$defs/Theme"
    }
  },
  "required": [
    "canvas"
  ],
  "title": "DashboardDocument",
  "type": "object"
}
