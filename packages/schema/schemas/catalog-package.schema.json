{
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "PackageFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "PackageFile",
      "type": "object"
    },
    "PluginComponent": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "data_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Data Schema",
          "type": "object"
        },
        "default_props": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Default Props",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "property_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Property Schema",
          "type": "object"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "category",
        "property_schema",
        "data_schema"
      ],
      "title": "PluginComponent",
      "type": "object"
    },
    "PluginManifest": {
      "additionalProperties": false,
      "properties": {
        "compatible_api": {
          "minLength": 1,
          "title": "Compatible Api",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/PluginComponent"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "entry": {
          "minLength": 1,
          "title": "Entry",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "license": {
          "default": "UNLICENSED",
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "default": "local",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "compatible_api",
        "name",
        "entry",
        "components"
      ],
      "title": "PluginManifest",
      "type": "object"
    },
    "TemplateManifest": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Assets",
          "type": "array"
        },
        "compatible_api": {
          "minLength": 1,
          "title": "Compatible Api",
          "type": "string"
        },
        "datasets": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Datasets",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "document": {
          "const": "document.json",
          "default": "document.json",
          "title": "Document",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "template",
          "default": "template",
          "title": "Kind",
          "type": "string"
        },
        "license": {
          "default": "UNLICENSED",
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "default": "local",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "compatible_api",
        "name"
      ],
      "title": "TemplateManifest",
      "type": "object"
    }
  },
  "$id": "https://datapulse.dev/schemas/v1/catalog-package.schema.json",
  "additionalProperties": false,
  "properties": {
    "compatible_api": {
      "minLength": 1,
      "title": "Compatible Api",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/PackageFile"
      },
      "title": "Files",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "installed_at": {
      "format": "date-time",
      "title": "Installed At",
      "type": "string"
    },
    "kind": {
      "enum": [
        "plugin",
        "template"
      ],
      "title": "Kind",
      "type": "string"
    },
    "license": {
      "minLength": 1,
      "title": "License",
      "type": "string"
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginManifest"
        },
        {
          "$ref": "#/$defs/TemplateManifest"
        }
      ],
      "title": "Manifest"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "id",
    "version",
    "name",
    "description",
    "license",
    "source",
    "compatible_api",
    "sha256",
    "installed_at",
    "manifest",
    "files"
  ],
  "title": "CatalogPackage",
  "type": "object"
}
