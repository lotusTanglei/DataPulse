{
  "$id": "https://datapulse.dev/schemas/v1/digital-human-provider.schema.json",
  "additionalProperties": false,
  "properties": {
    "base_url": {
      "title": "Base Url",
      "type": "string"
    },
    "circuit_open_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Circuit Open Until"
    },
    "configured": {
      "title": "Configured",
      "type": "boolean"
    },
    "consecutive_failures": {
      "minimum": 0,
      "title": "Consecutive Failures",
      "type": "integer"
    },
    "cost_per_minute": {
      "minimum": 0,
      "title": "Cost Per Minute",
      "type": "number"
    },
    "default_voice": {
      "title": "Default Voice",
      "type": "string"
    },
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "health_status": {
      "enum": [
        "unconfigured",
        "disabled",
        "healthy",
        "degraded",
        "open"
      ],
      "title": "Health Status",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "last_checked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Checked At"
    },
    "last_error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error Code"
    },
    "last_latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Latency Ms"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "provider_type": {
      "enum": [
        "openai_compatible",
        "azure",
        "custom"
      ],
      "title": "Provider Type",
      "type": "string"
    },
    "provider_version": {
      "title": "Provider Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "provider_type",
    "base_url",
    "default_voice",
    "language",
    "enabled",
    "configured",
    "cost_per_minute",
    "provider_version",
    "health_status",
    "consecutive_failures"
  ],
  "title": "DigitalHumanProviderResponse",
  "type": "object"
}
