 border: 1px solid var(--dp-border, #dfe5e8); border-radius: 6px;\n}\n.settings-toggle input[data-v-fa1eb11f] { width: 16px; height: 16px; margin: 2px 0 0; accent-color: var(--dp-accent, #1c8a78);\n}\n.settings-toggle span[data-v-fa1eb11f] { display: grid; gap: 4px;\n}\n.settings-toggle strong[data-v-fa1eb11f] { font-size: 13px;\n}\n.settings-toggle small[data-v-fa1eb11f], .settings-meta[data-v-fa1eb11f], .provider-url[data-v-fa1eb11f] { color: var(--dp-muted, #64737d); font-size: 12px;\n}\n.settings-meta[data-v-fa1eb11f] { margin: 14px 0 0;\n}\n.provider-create-grid[data-v-fa1eb11f] { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; align-items: end;\n}\n.provider-add[data-v-fa1eb11f] { align-self: end; justify-self: start;\n}\n.provider-form-actions[data-v-fa1eb11f] { display: flex; align-items: center; gap: 8px;\n}\n.form-error[data-v-fa1eb11f] { margin: 12px 0; color: #b42318; font-size: 13px;\n}\n.provider-table-wrap[data-v-fa1eb11f] { margin-top: 18px;\n}\n.provider-url[data-v-fa1eb11f] { display: block; margin-top: 3px; max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\n}\n.provider-actions[data-v-fa1eb11f] { display: flex; gap: 8px; align-items: center;\n}\n.voice-list[data-v-fa1eb11f] { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 4px;\n}\n.voice-list span[data-v-fa1eb11f] { padding: 2px 5px; border: 1px solid var(--dp-border, #dfe5e8); color: var(--dp-muted, #64737d); font-size: 10px;\n}\n.icon-button--danger[data-v-fa1eb11f] { color: #b42318;\n}\n.empty-inline[data-v-fa1eb11f] { margin: 18px 0 0; color: var(--dp-muted, #64737d); font-size: 13px;\n}\n.usage-grid[data-v-fa1eb11f] { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; border: 1px solid var(--dp-border, #dfe5e8); background: var(--dp-border, #dfe5e8);\n}\n.usage-grid > div[data-v-fa1eb11f] { display: grid; gap: 5px; padding: 16px; background: var(--dp-surface, #fff);\n}\n.usage-grid strong[data-v-fa1eb11f] { font-size: 24px; color: var(--dp-text, #18232b);\n}\n.usage-grid span[data-v-fa1eb11f] { color: var(--dp-muted, #64737d); font-size: 12px;\n}\n.digital-human-settings code[data-v-fa1eb11f] { font-size: 11px;\n}\n.is-spinning[data-v-fa1eb11f] { animation: spin-fa1eb11f 900ms linear infinite;\n}\n@keyframes spin-fa1eb11f {\nto { transform: rotate(360deg);\n}\n}\n@media (max-width: 900px) {\n.settings-toggle-row[data-v-fa1eb11f], .provider-create-grid[data-v-fa1eb11f] { grid-template-columns: 1fr 1fr;\n}\n.usage-grid[data-v-fa1eb11f] { grid-template-columns: repeat(3, 1fr);\n}\n}\n@media (max-width: 620px) {\n.settings-toggle-row[data-v-fa1eb11f], .provider-create-grid[data-v-fa1eb11f], .usage-grid[data-v-fa1eb11f] { grid-template-columns: 1fr;\n}\n.settings-section__heading[data-v-fa1eb11f] { flex-direction: column;\n}\n}\n"],["STYLE",{},":root {\n  --dp-surface: #ffffff;\n  --dp-sidebar: #f7f7f5;\n  --dp-text: #37352f;\n  --dp-muted: #787774;\n  --dp-subtle: #9b9a97;\n  --dp-border: #e9e9e7;\n  --dp-border-strong: #d9d9d6;\n  --dp-hover: rgb(55 53 47 / 6%);\n  --dp-active: rgb(55 53 47 / 9%);\n  --dp-action: #37352f;\n  --dp-danger: #d44c47;\n  --dp-danger-soft: #fbeceb;\n  --dp-info-soft: #f1f5f9;\n  --dp-radius-sm: 5px;\n  --dp-radius-md: 8px;\n  color: var(--dp-text);\n  background: var(--dp-surface);\n  font-family:\n    Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\",\n    \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  font-synthesis: none;\n  text-rendering: optimizeLegibility;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml,\nbody,\n#app {\n  min-width: 320px;\n  min-height: 100%;\n  margin: 0;\n}\n\nbody {\n  min-height: 100vh;\n  background: var(--dp-surface);\n}\n\nbutton,\ninput,\ntextarea,\nselect {\n  font: inherit;\n}\n\nbutton,\na {\n  -webkit-tap-highlight-color: transparent;\n}\n\na {\n  color: inherit;\n}\n\nbutton {\n  border: 0;\n}\n\ninput,\ntextarea,\nselect {\n  width: 100%;\n  min-height: 40px;\n  padding: 8px 10px;\n  border: 1px solid var(--dp-border-strong);\n  border-radius: var(--dp-radius-sm);\n  outline: none;\n  color: var(--dp-text);\n  background: var(--dp-surface);\n  box-shadow: 0 1px 1px rgb(15 23 42 / 3%);\n  transition:\n    border-color 120ms ease,\n    box-shadow 120ms ease;\n}\n\ninput:focus,\ntextarea:focus,\nselect:focus {\n  border-color: #a5a49f;\n  box-shadow: 0 0 0 2px rgb(55 53 47 / 10%);\n}\n\ninput::placeholder,\ntextarea::placeholder {\n  color: #aaa9a6;\n}\n\n.studio-frame {\n  display: grid;\n  grid-template-columns: 248px minmax(952px, 1fr);\n  min-width: 1200px;\n  min-height: 100vh;\n  background: var(--dp-surface);\n}\n\n.studio-sidebar {\n  position: sticky;\n  top: 0;\n  display: flex;\n  flex-direction: column;\n  width: 248px;\n  height: 100vh;\n  padding: 8px;\n  border-right: 1px solid var(--dp-border);\n  background: var(--dp-sidebar);\n}\n\n.workspace-switcher {\n  display: flex;\n  align-items: center;\n  min-height: 42px;\n  padding: 6px 8px;\n  border-radius: var(--dp-radius-sm);\n  font-size: 14px;\n  font-weight: 650;\n}\n\n.workspace-switcher:hover {\n  background: var(--dp-hover);\n}\n\n.workspace-mark {\n  display: inline-grid;\n  flex: 0 0 auto;\n  width: 26px;\n  height: 26px;\n  place-items: center;\n  border-radius: 6px;\n  color: #fff;\n  background: var(--dp-action);\n  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 14%);\n  font-size: 13px;\n  font-weight: 750;\n  letter-spacing: -0.02em;\n}\n\n.workspace-name {\n  overflow: hidden;\n  margin-left: 9px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.workspace-chevron {\n  margin-left: auto;\n  color: var(--dp-muted);\n  font-size: 15px;\n}\n\n.sidebar-nav {\n  display: grid;\n  gap: 2px;\n  margin-top: 11px;\n}\n\n.sidebar-link {\n  display: flex;\n  align-items: center;\n  min-height: 34px;\n  padding: 5px 8px;\n  border-radius: var(--dp-radius-sm);\n  color: #5f5e5b;\n  font-size: 14px;\n  line-height: 1.4;\n  text-decoration: none;\n  transition: background 100ms ease;\n}\n\n.sidebar-link:hover {\n  color: var(--dp-text);\n  background: var(--dp-hover);\n}\n\n.sidebar-link.router-link-active {\n  color: var(--dp-text);\n  background: var(--dp-active);\n  font-weight: 550;\n}\n\n.icon-glyph {\n  flex: 0 0 auto;\n  width: 18px;\n  height: 18px;\n  margin-right: 9px;\n  color: #787774;\n}\n\n.recent-section {\n  margin-top: 22px;\n}\n\n.sidebar-caption {\n  margin: 0 8px 6px;\n  color: var(--dp-subtle);\n  font-size: 11px;\n  font-weight: 650;\n  letter-spacing: 0.025em;\n}\n\n.recent-empty {\n  margin: 0;\n  padding: 7px 8px;\n  color: var(--dp-subtle);\n  font-size: 13px;\n}\n\n.sidebar-spacer {\n  flex: 1;\n}\n\n.account-row {\n  display: flex;\n  align-items: center;\n  min-height: 40px;\n  margin-top: 3px;\n  padding: 6px 8px;\n  border-top: 1px solid var(--dp-border);\n  color: var(--dp-muted);\n  font-size: 13px;\n}\n\n.account-avatar {\n  display: inline-grid;\n  width: 23px;\n  height: 23px;\n  place-items: center;\n  margin-right: 9px;\n  border: 1px solid #d7d6d2;\n  border-radius: 50%;\n  color: var(--dp-text);\n  background: #fff;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.account-name {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.account-logout {\n  display: inline-grid;\n  width: 28px;\n  height: 28px;\n  place-items: center;\n  margin-left: auto;\n  border: 0;\n  border-radius: 5px;\n  color: var(--dp-subtle);\n  background: transparent;\n  cursor: pointer;\n}\n\n.account-logout:hover {\n  color: var(--dp-text);\n  background: var(--dp-hover);\n}\n\n.account-logout:disabled {\n  cursor: wait;\n  opacity: 0.5;\n}\n\n.studio-main {\n  min-width: 0;\n  background: var(--dp-surface);\n}\n\n.studio-topbar {\n  position: sticky;\n  top: 0;\n  z-index: 10;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 48px;\n  padding: 0 24px;\n  border-bottom: 1px solid var(--dp-border);\n  background: rgb(255 255 255 / 92%);\n  backdrop-filter: blur(12px);\n}\n\n.breadcrumb {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--dp-subtle);\n  font-size: 13px;\n}\n\n.breadcrumb strong {\n  color: var(--dp-text);\n  font-weight: 550;\n}\n\n.environment-badge {\n  padding: 3px 7px;\n  border: 1px solid var(--dp-border);\n  border-radius: 999px;\n  color: var(--dp-muted);\n  background: #fafaf9;\n  font-size: 11px;\n}\n\n.studio-content {\n  padding: 64px 72px 96px;\n}\n\n.page-column {\n  width: min(960px, 100%);\n  margin: 0 auto;\n}\n\n.page-eyebrow {\n  margin: 0 0 12px;\n  color: var(--dp-muted);\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n.page-column h1,\n.auth-heading h1 {\n  margin: 0;\n  color: var(--dp-text);\n  font-size: 34px;\n  font-weight: 720;\n  line-height: 1.18;\n  letter-spacing: -0.035em;\n}\n\n.page-description {\n  max-width: 640px;\n  margin: 12px 0 40px;\n  color: var(--dp-muted);\n  font-size: 15px;\n  line-height: 1.7;\n}\n\n.empty-panel {\n  display: grid;\n  justify-items: center;\n  min-height: 300px;\n  place-content: center;\n  padding: 52px;\n  border: 1px solid var(--dp-border);\n  border-radius: var(--dp-radius-md);\n  color: var(--dp-muted);\n  background: #fcfcfb;\n  text-align: center;\n}\n\n.empty-panel__icon {\n  display: grid;\n  width: 42px;\n  height: 42px;\n  place-items: center;\n  margin-bottom: 18px;\n  border: 1px solid var(--dp-border-strong);\n  border-radius: 10px;\n  color: var(--dp-text);\n  background: #fff;\n  box-shadow: 0 1px 2px rgb(15 23 42 / 4%);\n  font-size: 22px;\n  font-weight: 300;\n}\n\n.empty-panel h2 {\n  margin: 0 0 7px;\n  color: var(--dp-text);\n  font-size: 15px;\n  font-weight: 650;\n}\n\n.empty-panel p {\n  margin: 0;\n  font-size: 13px;\n}\n\n.auth-layout {\n  display: grid;\n  min-height: 100vh;\n  place-items: center;\n  padding: 48px 24px;\n  background:\n    linear-gradient(rgb(55 53 47 / 2%) 1px, transparent 1px),\n    linear-gradient(90deg, rgb(55 53 47 / 2%) 1px, transparent 1px),\n    #fbfbfa;\n  background-size: 32px 32px;\n}\n\n.auth-card {\n  width: min(460px, 100%);\n  padding: 36px 38px 32px;\n  border: 1px solid var(--dp-border);\n  border-radius: 12px;\n  background: var(--dp-surface);\n  box-shadow:\n    0 1px 2px rgb(15 23 42 / 3%),\n    0 18px 50px rgb(15 23 42 / 6%);\n}\n\n.auth-card--login {\n  width: min(430px, 100%);\n}\n\n.auth-brand {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  margin-bottom: 34px;\n  font-size: 14px;\n  font-weight: 680;\n}\n\n.auth-heading {\n  margin-bottom: 28px;\n}\n\n.auth-heading h1 {\n  font-size: 29px;\n}\n\n.auth-heading > p:last-child {\n  margin: 10px 0 0;\n  color: var(--dp-muted);\n  font-size: 14px;\n  line-height: 1.65;\n}\n\n.auth-form {\n  display: grid;\n  gap: 17px;\n}\n\n.form-field {\n  display: grid;\n  gap: 6px;\n}\n\n.form-field__heading {\n  display: flex;\n  gap: 3px;\n  align-items: baseline;\n  color: var(--dp-text);\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.form-field__heading span {\n  color: var(--dp-danger);\n}\n\n.form-field__hint,\n.form-field__error {\n  margin: 0;\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.form-field__hint {\n  color: var(--dp-subtle);\n}\n\n.form-field__error {\n  color: var(--dp-danger);\n}\n\n.form-field[data-invalid=\"true\"] input,\n.form-field[data-invalid=\"true\"] select {\n  border-color: #df8a86;\n  box-shadow: 0 0 0 2px rgb(212 76 71 / 8%);\n}\n\n.primary-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 40px;\n  margin-top: 3px;\n  padding: 8px 14px;\n  border-radius: var(--dp-radius-sm);\n  color: #fff;\n  background: var(--dp-action);\n  box-shadow: 0 1px 2px rgb(15 23 42 / 12%);\n  font-size: 13px;\n  font-weight: 650;\n  cursor: pointer;\n  transition:\n    background 120ms ease,\n    transform 120ms ease;\n}\n\n.primary-button:hover:not(:disabled) {\n  background: #262522;\n}\n\n.primary-button:active:not(:disabled) {\n  transform: translateY(1px);\n}\n\n.primary-button:disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n.inline-notice {\n  display: grid;\n  grid-template-columns: 22px 1fr;\n  gap: 9px;\n  align-items: start;\n  margin: 0 0 20px;\n  padding: 10px 12px;\n  border: 1px solid #dce3ea;\n  border-radius: var(--dp-radius-sm);\n  color: #4b5563;\n  background: var(--dp-info-soft);\n  font-size: 12px;\n  line-height: 1.55;\n}\n\n.inline-notice[data-tone=\"error\"] {\n  border-color: #f2cecc;\n  color: #9f3732;\n  background: var(--dp-danger-soft);\n}\n\n.inline-notice[data-tone=\"warning\"] {\n  border-color: #d7a32f;\n  background: #fff8e6;\n  color: #634b10;\n}\n\n.inline-notice__icon {\n  display: inline-grid;\n  width: 19px;\n  height: 19px;\n  place-items: center;\n  border: 1px solid currentcolor;\n  border-radius: 50%;\n  font-size: 11px;\n  font-weight: 750;\n}\n\n.auth-footnote {\n  margin: 24px 0 0;\n  padding-top: 19px;\n  border-top: 1px solid var(--dp-border);\n  color: var(--dp-subtle);\n  font-size: 11px;\n  line-height: 1.6;\n}\n\n.page-heading-row {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 32px;\n}\n\n.primary-button--compact {\n  width: auto;\n  min-width: 0;\n  margin-top: 0;\n  padding: 9px 14px;\n  text-decoration: none;\n  white-space: nowrap;\n}\n\n.primary-button--compact,\n.secondary-button,\n.table-action {\n  gap: 7px;\n}\n\n.secondary-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 36px;\n  padding: 7px 13px;\n  border: 1px solid var(--dp-border-strong);\n  border-radius: var(--dp-radius-sm);\n  background: var(--dp-surface);\n  color: var(--dp-text);\n  font-size: 14px;\n  font-weight: 600;\n  text-decoration: none;\n  box-shadow: 0 1px 2px rgb(15 23 42 / 4%);\n}\n\n.loading-copy {\n  margin: 44px 0;\n  color: var(--dp-muted);\n}\n\n.request-id-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-top: 7px;\n}\n\n.request-id-row code,\n.address-copy {\n  font-family: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n}\n\n.text-button,\n.table-action {\n  border: 0;\n  background: transparent;\n  color: var(--dp-muted);\n  font: inherit;\n  cursor: pointer;\n}\n\n.text-button:hover,\n.table-action:hover {\n  color: var(--dp-text);\n  text-decoration: underline;\n}\n\n.datasource-empty {\n  min-height: 300px;\n}\n\n.notion-table-wrap {\n  overflow: hidden;\n  margin-top: 10px;\n  border: 1px solid var(--dp-border);\n  border-radius: var(--dp-radius-md);\n  background: var(--dp-surface);\n}\n\n.notion-table {\n  width: 100%;\n  border-collapse: collapse;\n  table-layout: fixed;\n  font-size: 13px;\n}\n\n.notion-table th,\n.notion-table td {\n  height: 52px;\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--dp-border);\n  color: var(--dp-text);\n  text-align: left;\n  vertical-align: middle;\n}\n\n.notion-table th {\n  height: 38px;\n  background: #fafaf9;\n  color: var(--dp-muted);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.notion-table tbody tr:last-child td {\n  border-bottom: 0;\n}\n\n.notion-table tbody tr:hover {\n  background: #fbfbfa;\n}\n\n.notion-table th:nth-child(1) {\n  width: 18%;\n}\n\n.notion-table th:nth-child(2) {\n  width: 13%;\n}\n\n.notion-table th:nth-child(3) {\n  width: 22%;\n}\n\n.notion-table th:nth-child(4) {\n  width: 11%;\n}\n\n.notion-table th:nth-child(5),\n.notion-table th:nth-child(6) {\n  width: 13%;\n}\n\n.notion-table th:nth-child(7) {\n  width: 10%;\n}\n\n.datasource-name {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  min-width: 0;\n  color: var(--dp-text);\n  font-weight: 600;\n  text-decoration: none;\n}\n\n.datasource-name:hover span:last-child {\n  text-decoration: underline;\n}\n\n.datasource-monogram {\n  display: inline-flex;\n  width: 26px;\n  height: 26px;\n  flex: 0 0 auto;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid var(--dp-border-strong);\n  border-radius: 6px;\n  background: var(--dp-sidebar);\n  color: var(--dp-muted);\n  font-size: 11px;\n}\n\n.type-pill {\n  display: inline-flex;\n  max-width: 100%;\n  padding: 3px 7px;\n  overflow: hidden;\n  border-radius: 4px;\n  background: #f1f1ef;\n  color: #5f5e5b;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.address-copy {\n  display: block;\n  overflow: hidden;\n  color: #5f5e5b;\n  font-size: 12px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.status-copy {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  white-space: nowrap;\n}\n\n.status-dot {\n  width: 7px;\n  height: 7px;\n  flex: 0 0 auto;\n  border-radius: 50%;\n  background: #a5a29d;\n}\n\n.status-copy[data-status=\"available\"] .status-dot {\n  background: #3f8f61;\n}\n\n.status-copy[data-status=\"unavailable\"] .status-dot {\n  background: #c65b5b;\n}\n\n.notion-table__actions {\n  text-align: right !important;\n}\n\n.table-action {\n  display: inline-flex;\n  align-items: center;\n  padding: 5px 4px;\n  color: var(--dp-text);\n  font-size: 12px;\n}\n\n.table-action:disabled {\n  color: var(--dp-muted);\n  cursor: wait;\n  text-decoration: none;\n}\n\n.table-row-error {\n  margin: 3px 0 0;\n  color: var(--dp-danger);\n  font-size: 11px;\n  line-height: 1.3;\n}\n\n.datasource-form {\n  display: grid;\n  gap: 16px;\n}\n\n.form-section {\n  display: grid;\n  grid-template-columns: 210px minmax(0, 1fr);\n  gap: 40px;\n  padding: 24px;\n  border: 1px solid var(--dp-border);\n  border-radius: var(--dp-radius-md);\n  background: var(--dp-surface);\n}\n\n.form-section__heading h2 {\n  margin: 0 0 7px;\n  font-size: 15px;\n  font-weight: 650;\n}\n\n.form-section__heading p {\n  margin: 0;\n  color: var(--dp-muted);\n  font-size: 12px;\n  line-height: 1.55;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 18px 20px;\n}\n\n.form-grid--single {\n  grid-template-columns: minmax(0, 1fr);\n}\n\n.checkbox-field {\n  display: flex;\n  grid-column: 1 / -1;\n  gap: 10px;\n  align-items: flex-start;\n  padding: 12px;\n  border: 1px solid var(--dp-border);\n  border-radius: var(--dp-radius-sm);\n  cursor: pointer;\n}\n\n.checkbox-field input {\n  width: 15px;\n  height: 15px;\n  margin-top: 2px;\n}\n\n.checkbox-field span {\n  display: grid;\n  gap: 2px;\n}\n\n.checkbox-field strong {\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.checkbox-field small {\n  color: var(--dp-muted);\n  font-size: 11px;\n}\n\n.form-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 9px;\n  padding-top: 4px;\n}\n\n.detail-heading {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 24px;\n}\n\n.detail-title {\n  display: flex;\n  gap: 14px;\n  align-items: flex-start;\n}\n\n.datasource-monogram--large {\n  width: 42px;\n  height: 42px;\n  margin-top: 2px;\n  border-radius: 8px;\n  font-size: 15px;\n}\n\n.detail-tabs {\n  display: flex;\n  gap: 3px;\n  margin-top: 4px;\n  border-bottom: 1px solid var(--dp-border);\n}\n\n.detail-tabs button {\n  position: relative;\n  padding: 10px 12px;\n  border: 0;\n  background: transparent;\n  color: var(--dp-muted);\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.detail-tabs button[aria-selected=\"true\"] {\n  color: var(--dp-text);\n  font-weight: 600;\n}\n\n.detail-tabs button[aria-selected=\"true\"]::after {\n  position: absolute;\n  right: 8px;\n  bottom: -1px;\n  left: 8px;\n  height: 2px;\n  background: var(--dp-text);\n  content: \"\";\n}\n\n.detail-panel {\n  padding: 24px;\n  border: 1px solid var(--dp-border);\n  border-radius: var(--dp-radius-md);\n  background: var(--dp-surface);\n}\n\n.detail-panel--flush {\n  padding: 0;\n}\n\n.property-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  margin: 0;\n}\n\n.property-grid > div {\n  display: grid;\n  grid-template-columns: 130px 1fr;\n  gap: 20px;\n  min-height: 48px;\n  align-items: center;\n  padding: 8px 12px;\n  border-bottom: 1px solid var(--dp-border);\n}\n\n.property-grid > div:nth-last-child(-n + 2) {\n  border-bottom: 0;\n}\n\n.property-grid dt {\n  color: var(--dp-muted);\n  font-size: 12px;\n}\n\n.property-grid dd {\n  min-width: 0;\n  margin: 0;\n  overflow: hidden;\n  color: var(--dp-text);\n  font-size: 13px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.property-grid code {\n  font-family: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n  font-size: 12px;\n}\n\n.placeholder-panel h2,\n.detail-panel > h2 {\n  margin: 0 0 8px;\n  font-size: 16px;\n}\n\n.schema-browser {\n  min-height: 360px;\n}\n\n.schema-toolbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 18px 20px;\n  border-bottom: 1px solid var(--dp-border);\n}\n\n.schema-toolbar h2 {\n  margin: 0 0 3px;\n  font-size: 15px;\n}\n\n.schema-toolbar p {\n  margin: 0;\n  color: var(--dp-muted);\n  font-size: 11px;\n}\n\n.catalog-tree {\n  padding: 8px 12px 18px;\n}\n\n.catalog-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: 38px;\n  border-bottom: 1px solid var(--dp-border);\n}\n\n.catalog-toggle {\n  display: flex;\n  min-width: 0;\n  flex: 1;\n  gap: 8px;\n  align-items: center;\n  padding: 9px 8px;\n  border: 0;\n  background: transparent;\n  color: var(--dp-text);\n  font-size: 13px;\n  text-align: left;\n  cursor: pointer;\n}\n\n.catalog-toggle small {\n  margin-left: auto;\n  color: var(--dp-muted);\n  font-size: 10px;\n}\n\n.catalog-branch {\n  margin-left: 18px;\n  border-left: 1px solid var(--dp-border);\n}\n\n.catalog-relation {\n  margin-left: 8px;\n}\n\n.catalog-fields {\n  margin-left: 26px;\n  border-left: 1px solid var(--dp-border);\n}\n\n.catalog-field {\n  display: grid;\n  grid-template-columns: minmax(120px, 1fr) minmax(100px, 0.7fr) 48px;\n  gap: 14px;\n  align-items: center;\n  min-height: 34px;\n  padding: 7px 10px;\n  border-bottom: 1px solid var(--dp-border);\n  font-size: 12px;\n}\n\n.catalog-field code {\n  color: var(--dp-muted);\n  font-family: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n  font-size: 11px;\n}\n\n.catalog-field small {\n  color: var(--dp-subtle);\n  font-size: 10px;\n}\n\n.catalog-loading,\n.catalog-error {\n  margin: 10px 18px;\n  padding: 9px 11px;\n  border-radius: var(--dp-radius-sm);\n  color: var(--dp-muted);\n  background: var(--dp-sidebar);\n  font-size: 11px;\n}\n\n.catalog-error {\n  color: var(--dp-danger);\n  background: var(--dp-danger-soft);\n}\n\n.catalog-error p {\n  margin: 0 0 4px;\n}\n\n.page-heading {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 28px;\n  margin-bottom: 34px;\n}\n\n.page-heading .page-description {\n  margin-bottom: 0;\n}\n\n.page-heading > .primary-button {\n  flex: 0 0 auto;\n  gap: 7px;\n  margin-top: 0;\n  text-decoration: none;\n  white-space: nowrap;\n}\n\n.sql-debug-workspace {\n  display: grid;\n  grid-template-columns: 230px minmax(0, 1fr);\n  min-height: 620px;\n}\n\n.sql-schema-panel {\n  min-width: 0;\n  overflow: auto;\n  border-right: 1px solid var(--dp-border);\n  background: #fbfbfa;\n}\n\n.sql-schema-panel .schema-browser {\n  min-height: 100%;\n}\n\n.sql-schema-panel .schema-toolbar {\n  padding: 15px 14px;\n}\n\n.sql-schema-panel .catalog-tree {\n  padding-inline: 7px;\n}\n\n.sql-workbench {\n  display: grid;\n  min-width: 0;\n  align-content: start;\n}\n\n.sql-toolbar {\n  display: flex;\n  min-height: 52px;\n  align-items: center;\n  justify-content: space-between;\n  gap: 14px;\n  padding: 8px 12px;\n  border-bottom: 1px solid var(--dp-border);\n}\n\n.query-policy,\n.query-actions,\n.result-summary {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n}\n\n.query-policy {\n  color: var(--dp-muted);\n  font-size: 11px;\n}\n\n.policy-badge {\n  padding: 3px 7px;\n  border: 1px solid #d6e2d7;\n  border-radius: 999px;\n  color: #4d6a50;\n  background: #f4f8f4;\n  font-weight: 650;\n}\n\n.query-actions {\n  flex: 0 0 auto;\n}\n\n.query-actions .primary-button,\n.query-actions .secondary-button {\n  min-height: 34px;\n  margin: 0;\n  gap: 6px;\n  padding: 6px 11px;\n  font-size: 12px;\n}\n\n.sql-editor-frame {\n  height: 260px;\n  overflow: hidden;\n  border-bottom: 1px solid var(--dp-border);\n}\n\n.sql-editor,\n.sql-editor > .cm-editor {\n  height: 100%;\n}\n\n.parameter-editor {\n  padding: 14px 16px;\n  border-bottom: 1px solid var(--dp-border);\n}\n\n.parameter-heading {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 10px;\n}\n\n.parameter-heading h3 {\n  margin: 0 0 3px;\n  font-size: 13px;\n}\n\n.parameter-heading p,\n.parameter-empty {\n  margin: 0;\n  color: var(--dp-muted);\n  font-size: 11px;\n}\n\n.quiet-button,\n.icon-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 0;\n  border-radius: var(--dp-radius-sm);\n  color: var(--dp-muted);\n  background: transparent;\n  cursor: pointer;\n}\n\n.quiet-button {\n  gap: 5px;\n  padding: 5px 7px;\n  font-size: 11px;\n}\n\n.quiet-button:hover,\n.icon-button:hover {\n  color: var(--dp-text);\n  background: var(--dp-hover);\n}\n\n.icon-button {\n  width: 30px;\n  height: 30px;\n  padding: 0;\n}\n\n.parameter-row {\n  display: grid;\n  grid-template-columns: minmax(110px, 0.8fr) 100px minmax(150px, 1.2fr) 30px;\n  gap: 8px;\n  align-items: start;\n  margin-top: 8px;\n}\n\n.parameter-row label,\n.dataset-config-grid label,\n.dialog-form label {\n  display: grid;\n  gap: 5px;\n  color: var(--dp-muted);\n  font-size: 11px;\n}\n\n.parameter-row input,\n.parameter-row select {\n  min-height: 34px;\n  padding: 6px 8px;\n  font-size: 12px;\n}\n\n.field-error {\n  color: var(--dp-danger);\n  font-size: 10px;\n}\n\n.query-result-panel {\n  min-width: 0;\n  padding: 14px 16px 18px;\n}\n\n.result-summary {\n  margin-bottom: 9px;\n  color: var(--dp-muted);\n  font-size: 11px;\n}\n\n.result-summary strong {\n  color: var(--dp-text);\n  font-size: 12px;\n}\n\n.result-summary code {\n  margin-left: auto;\n  font-family: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n}\n\n.result-warning {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  padding: 8px 10px;\n  border: 1px solid #eadfbd;\n  border-bottom: 0;\n  border-radius: var(--dp-radius-sm) var(--dp-radius-sm) 0 0;\n  color: #78652d;\n  background: #fbf8ee;\n  font-size: 11px;\n}\n\n.query-result-scroll {\n  position: relative;\n  width: 100%;\n  height: 340px;\n  overflow: auto;\n  border: 1px solid var(--dp-border);\n  border-radius: var(--dp-radius-sm);\n  background: #fff;\n}\n\n.result-warning + .query-result-scroll {\n  border-radius: 0 0 var(--dp-radius-sm) var(--dp-radius-sm);\n}\n\n.query-result-header {\n  position: sticky;\n  top: 0;\n  z-index: 2;\n  display: flex;\n  height: 42px;\n  border-bottom: 1px solid var(--dp-border-strong);\n  background: #f8f8f7;\n}\n\n.query-result-body {\n  position: relative;\n}\n\n.query-result-row {\n  position: absolute;\n  top: 0;\n  left: 0;\n  display: flex;\n  border-bottom: 1px solid var(--dp-border);\n}\n\n.query-result-row:hover {\n  background: #fbfbfa;\n}\n\n.query-result-cell {\n  flex: 0 0 auto;\n  overflow: hidden;\n  padding: 8px 10px;\n  border-right: 1px solid var(--dp-border);\n  font-family: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n  font-size: 11px;\n  line-height: 17px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.query-result-cell--header {\n  display: grid;\n  align-content: center;\n  padding-block: 5px;\n  font-family: inherit;\n}\n\n.query-result-cell--header strong {\n  overflow: hidden;\n  color: var(--dp-text);\n  font-size: 11px;\n  text-overflow: ellipsis;\n}\n\n.query-result-cell--header span {\n  color: var(--dp-subtle);\n  font-size: 9px;\n}\n\n.dialog-backdrop {\n  position: fixed;\n  z-index: 50;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: rgb(15 23 42 / 26%);\n}\n\n.dialog-card {\n  width: min(560px, 100%);\n  padding: 24px;\n  border: 1px solid var(--dp-border-strong);\n  border-radius: 10px;\n  background: #fff;\n  box-shadow: 0 24px 80px rgb(15 23 42 / 18%);\n}\n\n.dialog-heading {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  margin-bottom: 22px;\n}\n\n.dialog-heading h2 {\n  margin: 0;\n  font-size: 20px;\n}\n\n.dialog-form {\n  display: grid;\n  gap: 16px;\n}\n\n.dialog-form textarea {\n  resize: vertical;\n  font-family: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n  font-size: 12px;\n}\n\n.dialog-summary {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px 16px;\n  color: var(--dp-muted);\n  font-size: 11px;\n}\n\n.dialog-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n.dialog-actions .primary-button {\n  margin-top: 0;\n}\n\n.dataset-grid {\n  display: grid;\n  gap: 10px;\n}\n\n.dataset-card {\n  display: grid;\n  grid-template-columns: 36px minmax(0, 1fr) auto;\n  gap: 12px;\n  align-items: center;\n  padding: 14px 16px;\n  border: 1px solid var(--dp-border);\n  border-radius: var(--dp-radius-md);\n  color: inherit;\n  text-decoration: none;\n  transition:\n    border-color 100ms ease,\n    background 100ms ease;\n}\n\n.dataset-card:hover {\n  border-color: var(--dp-border-strong);\n  background: #fbfbfa;\n}\n\n.dataset-card-icon {\n  display: grid;\n  width: 34px;\n  height: 34px;\n  place-items: center;\n  border: 1px solid var(--dp-border);\n  border-radius: 7px;\n  color: var(--dp-muted);\n  background: #fff;\n}\n\n.dataset-card h2 {\n  margin: 0 0 4px;\n  font-size: 14px;\n}\n\n.dataset-card p {\n  margin: 0;\n  color: var(--dp-muted);\n  font-size: 11px;\n}\n\n.dataset-card-meta {\n  display: flex;\n  gap: 12px;\n  color: var(--dp-subtle);\n  font-size: 11px;\n}\n\n.dataset-detail-heading {\n  margin-bottom: 0;\n}\n\n.dataset-config-grid {\n  display: grid;\n  grid-template-columns: minmax(220px, 1fr) 120px 120px;\n  gap: 12px;\n  padding: 16px;\n  border: 1px solid var(--dp-border);\n  border-bottom: 0;\n  border-radius: var(--dp-radius-md) var(--dp-radius-md) 0 0;\n  background: #fbfbfa;\n}\n\n.dataset-config-grid input {\n  min-height: 36px;\n  font-size: 12px;\n}\n\n.dataset-config-grid input:disabled,\n.dataset-file-panel select:disabled {\n  color: var(--dp-muted);\n  background: #f8f8f7;\n  cursor: not-allowed;\n}\n\n.dataset-config-grid--stacked {\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  border-radius: var(--dp-radius-md);\n  border-bottom: 1px solid var(--dp-border);\n}\n\n.dataset-sql-editor {\n  border: 1px solid var(--dp-border);\n  border-bottom: 0;\n}\n\n.dataset-detail-page > .parameter-editor {\n  border: 1px solid var(--dp-border);\n  border-radius: 0 0 var(--dp-radius-md) var(--dp-radius-md);\n}\n\n.dataset-file-page,\n.dataset-file-detail {\n  gap: 16px;\n}\n\n.dataset-file-layout {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 16px;\n}\n\n.dataset-file-panel {\n  display: grid;\n  gap: 16px;\n  padding: 16px;\n  border: 1px solid var(--dp-border);\n  border-radius: var(--dp-radius-md);\n  background: #fff;\n}\n\n.dataset-file-panel h2 {\n  margin: 0;\n  font-size: 16px;\n}\n\n.dataset-file-panel select {\n  min-height: 36px;\n  padding: 6px 8px;\n  font-size: 12px;\n}\n\n.dataset-file-uploader {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  align-items: start;\n}\n\n.dataset-file-uploader h2 {\n  margin-bottom: 4px;\n}\n\n.dataset-file-uploader p,\n.dataset-file-asset p {\n  margin: 0;\n  color: var(--dp-muted);\n  font-size: 12px;\n}\n\n.dataset-file-input {\n  position: relative;\n  overflow: hidden;\n}\n\n.dataset-file-input input {\n  position: absolute;\n  inset: 0;\n  opacity: 0;\n  cursor: pointer;\n}\n\n.dataset-file-asset {\n  display: grid;\n  gap: 10px;\n  padding: 14px;\n  border: 1px solid var(--dp-border);\n  border-radius: var(--dp-radius-md);\n  background: #fbfbfa;\n}\n\n.dataset-file-asset__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.dataset-file-fields {\n  display: grid;\n  gap: 8px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.dataset-file-fields li {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 8px 10px;\n  border: 1px solid var(--dp-border);\n  border-radius: var(--dp-radius-sm);\n  background: #fff;\n  font-size: 11px;\n}\n\n@media (max-width: 1100px) {\n  .dataset-file-layout {\n    grid-template-columns: 1fr;\n  }\n\n  .studio-frame.studio-frame--editor {\n    grid-template-columns: minmax(0, 1fr);\n    min-width: 0;\n  }\n\n  .studio-frame--editor .studio-sidebar {\n    display: none;\n  }\n\n  .studio-frame--editor .studio-content {\n    min-width: 0;\n  }\n\n  .studio-frame--editor .editor-workspace {\n    grid-template-columns: minmax(0, 1fr);\n    height: auto;\n    min-height: 0;\n  }\n\n  .studio-frame--editor .editor-panel {\n    max-height: none;\n    overflow: visible;\n  }\n\n  .studio-frame--editor .editor-canvas-region {\n    min-height: min(70vh, 620px);\n  }\n\n  .studio-frame--editor .screen-canvas-host {\n    min-height: min(70vh, 620px);\n    padding: 16px;\n  }\n}\n\n.empty-state {\n  display: grid;\n  min-height: 300px;\n  justify-items: center;\n  place-content: center;\n  padding: 44px;\n  border: 1px solid var(--dp-border);\n  border-radius: var(--dp-radius-md);\n  color: var(--dp-muted);\n  text-align: center;\n}\n\n.empty-state .empty-icon {\n  display: grid;\n  width: 42px;\n  height: 42px;\n  place-items: center;\n  margin-bottom: 14px;\n  border: 1px solid var(--dp-border-strong);\n  border-radius: 9px;\n  color: var(--dp-text);\n}\n\n.empty-state h2 {\n  margin: 0 0 6px;\n  color: var(--dp-text);\n  font-size: 15px;\n}\n\n.empty-state p {\n  margin: 0 0 16px;\n  font-size: 12px;\n}\n\n.screen-list {\n  overflow: hidden;\n  border: 1px solid var(--dp-border);\n  border-radius: var(--dp-radius-md);\n  background: var(--dp-surface);\n}\n\n.screen-row {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: stretch;\n  border-bottom: 1px solid var(--dp-border);\n}\n\n.screen-row:last-child {\n  border-bottom: 0;\n}\n\n.screen-row:hover {\n  background: #fbfbfa;\n}\n\n.screen-row__main {\n  display: grid;\n  grid-template-columns: 36px minmax(0, 1fr) auto;\n  gap: 12px;\n  align-items: center;\n  min-height: 72px;\n  padding: 12px 8px 12px 16px;\n  color: inherit;\n  text-decoration: none;\n}\n\n.screen-row__icon {\n  display: grid;\n  width: 34px;\n  height: 34px;\n  place-items: center;\n  border: 1px solid var(--dp-border);\n  border-radius: 7px;\n  color: var(--dp-muted);\n  background: #fff;\n}\n\n.screen-row__copy {\n  display: grid;\n  min-width: 0;\n  gap: 5px;\n}\n\n.screen-row__title {\n  display: flex;\n  min-width: 0;\n  gap: 8px;\n  align-items: center;\n}\n\n.screen-row__title strong {\n  overflow: hidden;\n  font-size: 14px;\n  font-weight: 620;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.screen-row__description,\n.screen-row__updated {\n  color: var(--dp-muted);\n  font-size: 11px;\n}\n\n.screen-row__description {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.screen-row__updated {\n  padding-left: 20px;\n  white-space: nowrap;\n}\n\n.screen-status {\n  flex: 0 0 auto;\n  padding: 2px 6px;\n  border-radius: 4px;\n  color: #716f6a;\n  background: #f1f1ef;\n  font-size: 10px;\n  font-weight: 600;\n}\n\n.screen-status[data-published=\"true\"] {\n  color: #2f6e48;\n  background: #edf6f0;\n}\n\n.screen-row__actions {\n  display: flex;\n  gap: 2px;\n  align-items: center;\n  padding: 0 12px 0 4px;\n}\n\n.screen-action {\n  display: inline-flex;\n  gap: 5px;\n  align-items: center;\n  padding: 6px 7px;\n  border-radius: 5px;\n  color: var(--dp-muted);\n  background: transparent;\n  font-size: 11px;\n  cursor: pointer;\n}\n\n.screen-action:hover:not(:disabled) {\n  color: var(--dp-text);\n  background: var(--dp-hover);\n}\n\n.screen-action--danger:hover:not(:disabled) {\n  color: var(--dp-danger);\n  background: var(--dp-danger-soft);\n}\n\n.screen-action:disabled {\n  cursor: wait;\n  opacity: 0.45;\n}\n\n.screen-create-dialog {\n  width: min(440px, 100%);\n}\n\n.screen-create-dialog .dialog-heading {\n  margin-bottom: 18px;\n}\n\n.screen-create-dialog .dialog-heading p {\n  margin: 6px 0 0;\n  color: var(--dp-muted);\n  font-size: 12px;\n}\n\n.dialog-close {\n  display: grid;\n  width: 28px;\n  height: 28px;\n  place-items: center;\n  border-radius: 5px;\n  color: var(--dp-muted);\n  background: transparent;\n  cursor: pointer;\n}\n\n.dialog-close:hover:not(:disabled) {\n  color: var(--dp-text);\n  background: var(--dp-hover);\n}\n\n.screen-editor-page {\n  min-height: calc(100vh - 48px);\n}\n\n.studio-content:has(.screen-editor-page) {\n  padding: 0;\n}\n\n.editor-toolbar {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  height: 52px;\n  padding: 0 14px;\n  border-bottom: 1px solid var(--dp-border);\n  background: #fff;\n  overflow-x: auto;\n  overflow-y: hidden;\n}\n\n.editor-icon-button {\n  display: inline-grid;\n  width: 32px;\n  height: 32px;\n  place-items: center;\n  border-radius: 5px;\n  color: var(--dp-muted);\n  background: transparent;\n  cursor: pointer;\n}\n\n.editor-icon-button:hover:not(:disabled) {\n  color: var(--dp-text);\n  background: var(--dp-hover);\n}\n\n.editor-icon-button:disabled {\n  cursor: default;\n  opacity: 0.35;\n}\n\n.editor-text-tool {\n  width: auto;\n  padding: 0 7px;\n  font-size: 10px;\n}\n\n.editor-title {\n  display: grid;\n  gap: 1px;\n  min-width: 0;\n}\n\n.editor-title strong {\n  overflow: hidden;\n  font-size: 13px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.editor-title span {\n  color: var(--dp-subtle);\n  font-size: 10px;\n}\n\n.editor-title span[data-state=\"conflict\"],\n.editor-title span[data-state=\"failed\"] {\n  color: var(--dp-danger);\n}\n\n.editor-toolbar__spacer {\n  flex: 1;\n}\n\n.editor-save-button {\n  display: inline-flex;\n  gap: 5px;\n  align-items: center;\n  min-height: 32px;\n  padding: 5px 10px;\n  font-size: 12px;\n}\n\n.publish-confirmation {\n  width: min(440px, 100%);\n}\n\n.publish-confirmation .dialog-heading {\n  margin-bottom: 12px;\n}\n\n.publish-confirmation .dialog-heading p,\n.publish-confirmation > p {\n  margin: 8px 0 0;\n  color: var(--dp-muted);\n  font-size: 13px;\n  line-height: 1.7;\n}\n\n.publish-confirmation .dialog-actions {\n  margin-top: 24px;\n}\n\n.player-page {\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  width: 100vw;\n  height: 100vh;\n  overflow: hidden;\n  background: #0b1020;\n}\n\n.player-page:not([data-player-mode=\"preview\"]) {\n  grid-template-rows: minmax(0, 1fr);\n}\n\n.player-preview-bar {\n  z-index: 2;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: 48px;\n  padding: 0 16px;\n  border-bottom: 1px solid var(--dp-border);\n  background: #fff;\n}\n\n.player-preview-bar > div {\n  display: flex;\n  gap: 10px;\n  align-items: baseline;\n}\n\n.player-preview-bar strong {\n  color: var(--dp-text);\n  font-size: 13px;\n}\n\n.player-preview-bar span {\n  color: var(--dp-muted);\n  font-size: 12px;\n}\n\n.player-preview-bar .secondary-button {\n  min-height: 30px;\n  padding: 4px 10px;\n  font-size: 12px;\n}\n\n.player-stage {\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.player-status {\n  display: grid;\n  height: 100%;\n  margin: 0;\n  place-items: center;\n  color: #cbd5e1;\n  font-size: 13px;\n}\n\n.player-neutral-error {\n  display: grid;\n  align-content: center;\n  justify-items: center;\n  height: 100%;\n  color: #e2e8f0;\n  text-align: center;\n}\n\n.player-neutral-error strong {\n  font-size: 18px;\n}\n\n.player-neutral-error p {\n  margin: 8px 0 0;\n  color: #94a3b8;\n  font-size: 13px;\n}\n\n.editor-conflict {\n  margin: 12px 14px 0;\n}\n\n.editor-conflict p {\n  margin: 0;\n}\n\n.editor-workspace {\n  display: grid;\n  grid-template-columns: 220px minmax(0, 1fr) 300px;\n  height: calc(100vh - 100px);\n  min-height: 620px;\n  background: #f4f4f2;\n}\n\n.editor-panel {\n  padding: 18px 16px;\n  overflow-y: auto;\n  background: #fbfbfa;\n}\n\n.editor-panel--left {\n  border-right: 1px solid var(--dp-border);\n}\n\n.editor-panel--right {\n  border-left: 1px solid var(--dp-border);\n}\n\n.editor-panel h2,\n.component-library h2,\n.layers-panel h2,\n.inspector-panel h2 {\n  margin: 0 0 8px;\n  font-size: 12px;\n  font-weight: 650;\n}\n\n.editor-panel p {\n  margin: 0;\n  color: var(--dp-muted);\n  font-size: 11px;\n  line-height: 1.6;\n}\n\n.editor-canvas-region {\n  min-width: 0;\n  min-height: 0;\n}\n\n.screen-canvas-host {\n  position: relative;\n  box-sizing: border-box;\n  width: 100%;\n  height: 100%;\n  padding: 42px;\n  overflow: auto;\n  background: #eceeeb;\n}\n\n.screen-canvas-stage {\n  position: relative;\n  margin: auto;\n}\n\n.screen-canvas {\n  position: absolute;\n  inset: 0 auto auto 0;\n  overflow: hidden;\n  box-shadow: 0 16px 40px rgb(15 23 42 / 16%);\n  transform-origin: top left;\n}\n\n.screen-canvas.has-grid {\n  background-image:\n    linear-gradient(rgb(148 163 184 / 12%) 1px, transparent 1px),\n    linear-gradient(90deg, rgb(148 163 184 / 12%) 1px, transparent 1px);\n  background-size: 10px 10px;\n}\n\n.canvas-guide {\n  position: absolute;\n  z-index: 10000;\n  pointer-events: none;\n  background: #2383e2;\n  opacity: 0.85;\n}\n\n.canvas-guide.is-vertical {\n  width: 1px;\n}\n\n.canvas-guide.is-horizontal {\n  height: 1px;\n}\n\n.editor-canvas-component {\n  position: absolute;\n  padding: 0;\n  overflow: hidden;\n  border: 1px solid transparent;\n  color: inherit;\n  background: transparent;\n  cursor: move;\n}\n\n.editor-canvas-component.is-selected {\n  border-color: #2383e2;\n  box-shadow: 0 0 0 1px #2383e2;\n}\n\n.editor-canvas-component.is-hovered:not(.is-selected) {\n  border-color: rgb(35 131 226 / 75%);\n}\n\n.editor-canvas-component.is-overlapped {\n  border-style: dashed;\n  border-color: #f59e0b;\n  box-shadow: 0 0 0 1px rgb(245 158 11 / 55%);\n}\n\n.canvas-component-label {\n  position: absolute;\n  z-index: 2;\n  top: -1px;\n  left: -1px;\n  max-width: 100%;\n  padding: 2px 5px;\n  overflow: hidden;\n  color: #fff;\n  background: #2383e2;\n  font-size: 9px;\n  line-height: 1.3;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  pointer-events: none;\n}\n\n.editor-canvas-component.is-overlapped .canvas-component-label {\n  background: #d97706;\n}\n\n.editor-canvas-component.is-locked {\n  cursor: default;\n}\n\n.canvas-component-error {\n  position: absolute;\n  z-index: 4;\n  right: 8px;\n  bottom: 8px;\n  display: flex;\n  gap: 6px;\n  align-items: center;\n  padding: 5px 7px;\n  border: 1px solid rgb(248 113 113 / 45%);\n  border-radius: 4px;\n  color: #fecaca;\n  background: rgb(69 10 10 / 88%);\n  font-size: 10px;\n}\n\n.canvas-component-error button {\n  padding: 2px 5px;\n  border-radius: 3px;\n  color: #fff;\n  background: rgb(239 68 68 / 75%);\n  cursor: pointer;\n}\n\n.canvas-status {\n  position: sticky;\n  z-index: 10001;\n  bottom: -34px;\n  left: 0;\n  display: flex;\n  gap: 12px;\n  width: max-content;\n  margin: 12px 0 -28px;\n  padding: 5px 9px;\n  border: 1px solid rgb(15 23 42 / 10%);\n  border-radius: 4px;\n  color: #64748b;\n  background: rgb(255 255 255 / 92%);\n  box-shadow: 0 2px 8px rgb(15 23 42 / 8%);\n  font-size: 10px;\n  pointer-events: none;\n}\n\n.component-library {\n  padding-bottom: 16px;\n  border-bottom: 1px solid var(--dp-border);\n}\n\n.component-library__group + .component-library__group {\n  margin-top: 16px;\n}\n\n.component-library__group h3 {\n  margin: 0 0 7px;\n  color: var(--dp-subtle);\n  font-size: 10px;\n  font-weight: 650;\n  letter-spacing: 0.02em;\n}\n\n.component-library__grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 6px;\n}\n\n.component-library__grid button {\n  display: grid;\n  gap: 5px;\n  place-items: stretch;\n  min-height: 82px;\n  padding: 8px;\n  border: 1px solid var(--dp-border);\n  border-radius: 5px;\n  color: var(--dp-muted);\n  background: #fff;\n  font-size: 10px;\n  cursor: pointer;\n}\n\n.component-library__grid button:hover {\n  color: var(--dp-text);\n  background: var(--dp-hover);\n}\n\n.component-library__preview {\n  display: flex;\n  min-width: 0;\n  height: 34px;\n  align-items: center;\n  gap: 7px;\n  color: #315d78;\n}\n\n.component-library__icon {\n  flex: 0 0 auto;\n  width: 18px;\n  height: 18px;\n}\n\n.component-library__mini-visual {\n  position: relative;\n  display: flex;\n  flex: 1;\n  min-width: 0;\n  height: 24px;\n  align-items: end;\n  gap: 3px;\n  padding: 3px 4px;\n  overflow: hidden;\n  border: 1px solid #dbe5ec;\n  border-radius: 4px;\n  background: #f6f9fb;\n}\n\n.component-library__mini-visual i {\n  display: block;\n  flex: 1;\n  min-width: 2px;\n  border-radius: 2px 2px 0 0;\n  background: #68b8b1;\n}\n\n.component-library__preview[data-preview=\"line\"] .component-library__mini-visual {\n  align-items: center;\n  gap: 0;\n  border: 0;\n  background:\n    linear-gradient(155deg, transparent 0 18%, #68b8b1 19% 23%, transparent 24% 39%, #68b8b1 40% 44%, transparent 45% 64%, #68b8b1 65% 69%, transparent 70%);\n}\n\n.component-library__preview[data-preview=\"line\"] .component-library__mini-visual i {\n  width: 4px;\n  height: 4px !important;\n  flex: 0 0 4px;\n  border: 1px solid #fff;\n  border-radius: 50%;\n  background: #315d78;\n}\n\n.component-library__preview[data-preview=\"pie\"] .component-library__mini-visual {\n  width: 25px;\n  flex: 0 0 25px;\n  border: 0;\n  border-radius: 50%;\n  background: conic-gradient(#68b8b1 0 42%, #7c9ee6 42% 71%, #efba5c 71% 100%);\n}\n\n.component-library__preview[data-preview=\"pie\"] .component-library__mini-visual i,\n.component-library__preview[data-preview=\"gauge\"] .component-library__mini-visual i {\n  display: none;\n}\n\n.component-library__preview[data-preview=\"gauge\"] .component-library__mini-visual {\n  width: 27px;\n  flex: 0 0 27px;\n  height: 17px;\n  border: 3px solid #68b8b1;\n  border-bottom-color: transparent;\n  border-radius: 24px 24px 0 0;\n  background: transparent;\n}\n\n.component-library__preview[data-preview=\"table\"] .component-library__mini-visual {\n  border-color: #dbe5ec;\n  background:\n    linear-gradient(#9bb4c3 0 0) 0 6px / 100% 1px no-repeat,\n    repeating-linear-gradient(90deg, transparent 0 33%, #dbe5ec 33% 36%, transparent 36% 100%),\n    repeating-linear-gradient(0deg, transparent 0 31%, #dbe5ec 31% 35%, transparent 35% 100%),\n    #f6f9fb;\n}\n\n.component-library__preview[data-preview=\"table\"] .component-library__mini-visual i,\n.component-library__preview[data-preview=\"list\"] .component-library__mini-visual i,\n.component-library__preview[data-preview=\"number\"] .component-library__mini-visual i,\n.component-library__preview[data-preview=\"panel\"] .component-library__mini-visual i {\n  display: none;\n}\n\n.component-library__preview[data-preview=\"list\"] .component-library__mini-visual {\n  display: grid;\n  align-content: center;\n  gap: 4px;\n  border: 0;\n  background: transparent;\n}\n\n.component-library__preview[data-preview=\"list\"] .component-library__mini-visual::before,\n.component-library__preview[data-preview=\"list\"] .component-library__mini-visual::after {\n  display: block;\n  height: 3px;\n  border-radius: 2px;\n  background: #b0c1cc;\n  content: \"\";\n}\n\n.component-library__preview[data-preview=\"number\"] .component-library__mini-visual {\n  display: grid;\n  align-content: center;\n  gap: 4px;\n  border: 0;\n  background: transparent;\n}\n\n.component-library__preview[data-preview=\"number\"] .component-library__mini-visual::before {\n  display: block;\n  width: 78%;\n  height: 8px;\n  border-radius: 2px;\n  background: #315d78;\n  content: \"\";\n}\n\n.component-library__preview[data-preview=\"panel\"] .component-library